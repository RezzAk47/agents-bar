{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the one popup window may do. No file-system plugin, no shell plugin, no http plugin.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-fs-read",
    "allow-fs-stat",
    "allow-fs-write",
    "allow-fs-move-aside",
    "allow-set-tray-label",
    "allow-hide-popup",
    "allow-quit-app",
    "allow-scan-transcripts",
    "allow-gh-user",
    "allow-gh-repo-list",
    "allow-gh-run-list",
    "allow-reveal-transcript",
    "allow-open-repo",
    "allow-notify",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
